---
import Layout from '../../layouts/Layout.astro';
import Icon from '../../components/Icon.astro';
import { getContent, authenticated } from '../../lib/server';
import {
  publishedArticles,
  renderArticle,
  readingMinutes,
  formatArticleDate,
} from '../../lib/articles';
import '../../styles/articles.css';

const { content: c } = await getContent();
const previewRequested = Astro.url.searchParams.get('preview') === '1';
const preview = previewRequested && (await authenticated(Astro.request));
const article = c.articles.items.find(
  (item) =>
    item.slug === Astro.params.slug && (item.status === 'published' || preview),
);
if (!article) return Astro.rewrite('/404');
if (previewRequested) {
  Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
  Astro.response.headers.set('Cache-Control', 'private, no-store');
}
const related = publishedArticles(c.articles.items)
  .filter((item) => item.id !== article.id)
  .slice(0, 3);
const url = `https://brezmadeza.si/nasveti/${article.slug}`;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BlogPosting',
      headline: article.title,
      description: article.excerpt,
      mainEntityOfPage: url,
      inLanguage: 'sl-SI',
      ...(article.image
        ? { image: new URL(article.image, Astro.site).href }
        : {}),
      ...(article.publishedAt ? { datePublished: article.publishedAt } : {}),
      ...(article.updatedAt ? { dateModified: article.updatedAt } : {}),
      author: {
        '@type': 'Organization',
        name: c.brand.name,
        url: 'https://brezmadeza.si',
      },
      publisher: {
        '@type': 'Organization',
        name: c.brand.name,
        url: 'https://brezmadeza.si',
      },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Domov',
          item: 'https://brezmadeza.si',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Nasveti',
          item: 'https://brezmadeza.si/nasveti',
        },
        { '@type': 'ListItem', position: 3, name: article.title, item: url },
      ],
    },
  ],
};
---

<Layout
  content={c}
  title={`${article.title} | ${c.brand.name}`}
  description={article.excerpt}
  socialImage={article.image || c.seo.socialImage}
  ogType="article"
  noindex={previewRequested}
  schema={previewRequested ? undefined : schema}
>
  <main id="vsebina" class="article-page">
    {preview && (
      <aside class="article-preview-banner" role="status">
        Predogled prispevka ·{' '}
        {article.status === 'draft'
          ? 'Osnutek še ni javno objavljen.'
          : 'Prispevek je objavljen.'}
        <a href="/admin">Nazaj v urejevalnik ↗</a>
      </aside>
    )}
    <div class="container article-container">
      <nav class="breadcrumbs" aria-label="Drobtinice">
        <a href="/">{c.ui.home}</a>
        <span aria-hidden="true">/</span>
        <a href="/nasveti">Nasveti</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{article.title}</span>
      </nav>
      <article>
        <header class="article-header">
          <p class="eyebrow">
            <Icon name="leaf" size={17} />
            {article.category || 'Nasveti za dom'}
          </p>
          <h1>{article.title}</h1>
          <p class="article-lead">{article.excerpt}</p>
          <div class="advice-meta">
            <span>{c.brand.name}</span>
            {article.publishedAt && (
              <time datetime={article.publishedAt}>
                {formatArticleDate(article.publishedAt)}
              </time>
            )}
            <span>
              <Icon name="clock" size={14} />
              {readingMinutes(article.body)} min branja
            </span>
          </div>
        </header>
        {article.image && (
          <figure class="article-cover">
            <img
              src={article.image}
              alt={article.imageAlt}
              width="1200"
              height="720"
              fetchpriority="high"
            />
          </figure>
        )}
        <div class="article-body" set:html={renderArticle(article.body)} />
        <footer class="article-end">
          <a class="text-link" href="/nasveti">
            <span aria-hidden="true">←</span> Vsi nasveti
          </a>
          <span>Za dom, v katerem se dobro počutite.</span>
        </footer>
      </article>
    </div>
    <section class="container advice-cta">
      <div>
        <p class="eyebrow">Potrebujete pomoč pri čiščenju?</p>
        <h2>
          Svež začetek
          <br />
          za vaš dom.
        </h2>
        <p>
          Opišite nam, kaj potrebuje čiščenje, in skupaj bomo poiskali pravo
          rešitev.
        </p>
      </div>
      <a href="/#kontakt" class="button">
        {c.nav.cta}
        <Icon name="arrow" size={18} />
      </a>
    </section>
    {related.length > 0 && (
      <section class="container article-related">
        <div class="article-related-heading">
          <h2>Morda vas zanima tudi</h2>
          <a href="/nasveti" class="text-link">
            Vsi nasveti <Icon name="arrow" size={17} />
          </a>
        </div>
        <div class="advice-grid">
          {related.map((item) => (
            <article class="advice-card">
              <div class="advice-card-copy">
                <p class="eyebrow">{item.category || 'Nasveti za dom'}</p>
                <h3>
                  <a href={`/nasveti/${item.slug}`}>{item.title}</a>
                </h3>
                <p>{item.excerpt}</p>
                <a
                  href={`/nasveti/${item.slug}`}
                  class="text-link"
                  aria-label={`Preberite prispevek: ${item.title}`}
                >
                  Preberite prispevek <Icon name="arrow" size={17} />
                </a>
              </div>
            </article>
          ))}
        </div>
      </section>
    )}
  </main>
</Layout>
